NODE_ENV=production
PORT=4000

# Use your managed MongoDB URI in production.
# MongoDB transactions require a replica set or MongoDB Atlas.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/fahampesa
MONGODB_ALLOW_STANDALONE_WRITES=false

APP_BASE_URL=https://api.example.com
NEXT_PUBLIC_BASE_URL=https://www.example.com

FIREBASE_PROJECT_ID=fahampesa-8c514
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fahampesa-8c514.iam.gserviceaccount.com

# Recommended for Coolify: use a base64-encoded PEM private key to avoid
# newline and quote handling issues in the dashboard.
# This is still the Firebase service account private_key field, just base64 encoded.
FIREBASE_PRIVATE_KEY=BASE64_ENCODED_PRIVATE_KEY_PEM

FIREBASE_STORAGE_BUCKET=fahampesa-8c514.appspot.com

MPESA_ENVIRONMENT=production
MPESA_SHORTCODE=YOUR_MPESA_SHORTCODE
MPESA_PASSKEY=YOUR_MPESA_PASSKEY
MPESA_CONSUMER_KEY=YOUR_MPESA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_MPESA_CONSUMER_SECRET
MPESA_CALLBACK_URL=https://www.example.com/api/mpesa/callback

STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
